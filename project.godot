; IRONHIVE — cấu hình project
; Xem docs/02-TDD.md §1 (nền tảng), §4 (thứ tự autoload).
;
; QUY TẮC: file này do agent điều phối sở hữu. Agent triển khai task KHÔNG
; được sửa trực tiếp — báo lại để đăng ký autoload/input action mới.

config_version=5

[application]

config/name="IRONHIVE"
config/description="Top-down mech shooter. Xem docs/00-VISION.md"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[autoload]

Logger="*res://src/autoload/logger.gd"
EventBus="*res://src/autoload/event_bus.gd"
ContentDB="*res://src/autoload/content_db.gd"
PoolManager="*res://src/autoload/pool_manager.gd"
GameDirector="*res://src/autoload/game_director.gd"

[debug]

gdscript/warnings/enable=true
gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=1
gdscript/warnings/return_value_discarded=1
gdscript/warnings/shadowed_variable=1
gdscript/warnings/unused_variable=1
gdscript/warnings/unused_parameter=1
gdscript/warnings/standalone_expression=2
gdscript/warnings/integer_division=1

[physics]

3d/default_gravity=24.0
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
