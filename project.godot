; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="IRONHIVE"
config/description="Top-down mech shooter. Xem docs/00-VISION.md"
run/main_scene="res://scenes/main/test_arena.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Log="*res://src/autoload/log.gd"
EventBus="*res://src/autoload/event_bus.gd"
SettingsManager="*res://src/autoload/settings_manager.gd"
ContentDB="*res://src/autoload/content_db.gd"
PoolManager="*res://src/autoload/pool_manager.gd"
JuiceDirector="*res://src/autoload/juice_director.gd"
GameDirector="*res://src/autoload/game_director.gd"

[debug]

gdscript/warnings/standalone_expression=2
gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=1
gdscript/warnings/return_value_discarded=1

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

